<?xml version="1.0" encoding="utf-8"?>
<!-- Снимок чека кладётся в кэш и отдаётся камере через FileProvider:
     прямой file:// Android с 7.0 не принимает. -->
<paths>
    <cache-path name="receipts" path="receipts/" />
    <!-- файлы, которые отдаём через «Поделиться»: резервная копия, выгрузка -->
    <cache-path name="share" path="share/" />
</paths>
